{
  "manifest_version": 3,
  "name": "Dopameet",
  "description": "Google Meet のリアクションに合わせて、発表中の画面を盛り上げたり暗くしたりします。",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "action": {
    "default_title": "Dopameet",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://meet.google.com/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
